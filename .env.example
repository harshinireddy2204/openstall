# Copy to .env and fill in. Never commit .env.
# Public URL of this app (used for PayPal return URLs). Use your Render URL in production.
BASE_URL=http://localhost:8000

# PayPal sandbox app credentials: developer.paypal.com > Apps & Credentials (Sandbox)
# Leave blank to run in mock mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook ID from the same app's Webhooks section (needed to verify webhook signatures)
PAYPAL_WEBHOOK_ID=
# Optional: a sandbox BUSINESS account email to receive payments for the seeded demo stalls
DEMO_SELLER_PAYPAL_EMAIL=
# Optional: fixed dashboard key for the seeded demo stalls (so judges' links survive restarts)
DEMO_OWNER_KEY=

# Anthropic API key (console.anthropic.com). Leave blank for the offline text parser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# AG Studio license key for seller Insights (optional: without it charts show a trial watermark)
AG_STUDIO_LICENSE_KEY=

DATABASE_PATH=openstall.db

# Market runs: 'single' = one PayPal approval for every stall (default), 'split' = one checkout per stall
MARKET_CHECKOUT=single

# Optional: give demo stalls their own sandbox seller accounts (stall-id=email, comma separated)
DEMO_STALL_PAYEES=
